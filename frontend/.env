# Frontend Environment Configuration
# This file contains environment variables for the NetruDoc frontend application

# API Configuration
# Base URL for API calls (with /api suffix)
VITE_API_URL=http://localhost:5000/api

# Socket.IO Configuration
# WebSocket URL for real-time communication (no /api suffix)
VITE_SOCKET_URL=http://localhost:5000

# Client URL (for CORS and redirects)
# The URL where the frontend is hosted
VITE_CLIENT_URL=http://localhost:3000

# Development Configuration
# Set to 'development' or 'production'
VITE_NODE_ENV=development

# Application Configuration
VITE_APP_NAME=NetruDoc
VITE_APP_VERSION=1.0.0

# Stripe Configuration (Test) - Get from https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51T5lyZFhEA0ATbmc5YoKgoYOWDTOBhoYbpMXguAwLziWfL5S5zZlaEfSNsEOP63T1wd3VeW9lsVzgkJaTuHU2Vrz001kgPtEMO


# ============================================================================
# DEVELOPMENT EXAMPLES (uncomment and modify for different environments)
# ============================================================================

# Example for local development:
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000
# VITE_CLIENT_URL=http://localhost:3000

# Example for production:
# VITE_API_URL=https://api.netrudoc.com/api
# VITE_SOCKET_URL=https://api.netrudoc.com
# VITE_CLIENT_URL=https://netrudoc.com

# Example for local network testing:
# VITE_API_URL=http://192.168.1.100:5000/api
# VITE_SOCKET_URL=http://192.168.1.100:5000
# VITE_CLIENT_URL=http://192.168.1.100:3000