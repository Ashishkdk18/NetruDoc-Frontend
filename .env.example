# Frontend Environment Configuration
# This file contains environment variables for the NetruDoc frontend application

# API Configuration
# Base URL for API calls (with /api suffix)
VITE_API_URL=https://npgp0xgx-5000.inc1.devtunnels.ms/api

# Socket.IO Configuration
# WebSocket URL for real-time communication (no /api suffix)
VITE_SOCKET_URL=https://npgp0xgx-5000.inc1.devtunnels.ms

# Client URL (for CORS and redirects)
# The URL where the frontend is hosted
VITE_CLIENT_URL=https://npgp0xgx-3000.inc1.devtunnels.ms

# Development Configuration
# Set to 'development' or 'production'
VITE_NODE_ENV=development

# Application Configuration
VITE_APP_NAME=NetruDoc
VITE_APP_VERSION=1.0.0

